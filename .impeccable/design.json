  "narrative": {
    "northStar": "Incumbent editorial investor presentations",
    "overview": "This records the shipped identity, rather than proposing a new one. Warm ivory, near-black ink, spacious serif headings and clear sans-serif reading text establish the shared presentation frame. AVA forest and MemorX teal distinguish product actions without competing with the supplied logos.\n\nThe selector extends the deck's editorial rules into flat, equal navigation surfaces. The presentations also use rounded controls, contained media and occasional soft shadows; those treatments remain specific to their components. This record covers the selector and the shared deck vocabulary it inherits, not every slide-specific composition. Source authority is `public/styles.css`, `public/index.html` and `public/app.js`; desktop, mobile and 1280px review captures confirm the selector's rendered form. Product commitments remain in `PRODUCT.md`, and entry-state behavior remains in `.impeccable/surfaces/product-selector.md`.",
    "keyCharacteristics": [
      "Shared ivory canvas and ink typography.",
      "Product-specific forest and teal actions.",
      "Supplied logos, preserved as image assets.",
      "Serif hierarchy paired with readable sans-serif text.",
      "Flat editorial rules for navigation; restrained depth for deck media and overlays."
    ],
    "rules": [
      {
        "name": "The Product Accent Rule",
        "body": "Match action color to the product context. MemorX's selector link changes its local accent while the shared selector canvas and descriptive text retain the default neutral palette.",
        "section": "colors"
      },
      {
        "name": "The Logo Integrity Rule",
        "body": "Use the supplied AVA and MemorX image assets with contained fitting and their original proportions; do not rebuild their lettering as live text.",
        "section": "typography"
      },
      {
        "name": "The Ruled Navigation Rule",
        "body": "Preserve the selector's flat shared canvas and thin dividers; apply the deck's overlay depth only to actual overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** retain the supplied fonts and original logo assets.",
      "**Do** match product actions to forest or teal through the Product Accent Rule.",
      "**Do** preserve equal structural prominence for the two selector links.",
      "**Do** keep native link semantics, visible keyboard focus and reduced-motion behavior.",
      "**Do** scope soft corners and depth to the deck components that use them."
    ],
    "donts": [
      "**Don't** turn selector options into raised, rounded cards.",
      "**Don't** recolor or retype the supplied logos.",
      "**Don't** nest buttons inside the product links.",
      "**Don't** use deck-only uppercase financing labels as a new heading tier on future surfaces."
    ]
  }
}
